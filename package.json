{
  "name": "eufy-agent-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Capability modules, CLI/API foundations and interfaces for an agent-powered eufy app",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "npm --prefix vendor/eufy-security-client ci",
    "build": "npm --prefix vendor/eufy-security-client run build:ts",
    "start": "node interface/server.cjs",
    "test": "node --test \"capabilities/**/*.test.cjs\" \"api/**/*.test.cjs\" \"interface/**/*.test.cjs\" \"jobs/**/*.test.cjs\" \"cli/**/*.test.cjs\" \"agent/**/*.test.cjs\"",
    "agent": "node agent/main.cjs",
    "agent:smoke": "node agent/validate.cjs"
  },
  "dependencies": {
    "@openai/agents": "0.18.0",
    "ajv": "8.20.0",
    "openai": "7.15.0",
    "zod": "4.1.13"
  },
  "bin": {
    "eufy": "cli/eufy.cjs"
  },
  "devDependencies": {
    "linkedom": "^0.18.13"
  }
}
